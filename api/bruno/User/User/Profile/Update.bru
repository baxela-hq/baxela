meta {
  name: Update
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/v1/user/user/profile
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "full_name": "Meysam Miami",
    "display_name": "meysam",
    "bio": "Just a shopper.",
    "avatar": null,
    "gender": "male",
    "date_of_birth": "1990-05-15"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
