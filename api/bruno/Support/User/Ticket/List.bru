meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/support/user/tickets
  body: none
  auth: bearer
}

params:query {
  ~per_page: 15
  ~page: 1
  ~sort: -id
  ~filter[status]: open
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
