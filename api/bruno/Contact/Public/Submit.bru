meta {
  name: Submit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/contact/public/messages
  body: json
  auth: none
}

params:query {
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "name": "John Doe",
    "email": "john@example.com",
    "phone": "+1 555 000 0000",
    "subject": "Order inquiry",
    "content": "Hello, I would like to ask about the status of my recent order."
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
