meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/content/public/posts
  body: none
  auth: inherit
}

params:query {
  ~category: news
  ~featured: true
  ~page: 1
  ~per_page: 15
}

headers {
  Content-Type: application/json
}

settings {
  encodeUrl: true
  timeout: 0
}
