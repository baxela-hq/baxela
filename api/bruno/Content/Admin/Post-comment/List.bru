meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/content/admin/post-comments
  body: none
  auth: bearer
}

params:query {
  ~filter[status]: pending
  ~filter[post_id]: 13
  ~page: 1
  ~per_page: 15
  ~sort: -created_at
  ~sort: status
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
