meta {
  name: Update
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/v1/setting/admin/settings
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  [
    {
      "name": "website_title",
      "value": "Baxela",
      "translations": [
        {
          "language": "en",
          "value": "Baxela"
        },
        {
          "language": "fa",
          "value": "فروشگاه ایکس"
        }
      ]
    },
    {
      "name": "website_description",
      "value": "Powered by Baxela",
      "translations": [
        {
          "language": "en",
          "value": "Powered by Baxela"
        },
        {
          "language": "fa",
          "value": "قدرت گرفته از ایکسشاپ"
        }
      ]
    },
    {
      "name": "language_id",
      "value": "1"
    },
    {
      "name": "currency_id",
      "value": "1"
    },
    {
      "name": "announcement_text",
      "value": "<p>Free shipping on orders over $75 — 30-day returns, no questions asked.</p>",
      "translations": [
        {
          "language": "en",
          "value": "<p>Free shipping on orders over $75 — 30-day returns, no questions asked.</p>"
        },
        {
          "language": "fa",
          "value": "<p>ارسال رایگان برای سفارش‌های بالای ۷۵ دلار — مرجوعی تا ۳۰ روز، بدون هیچ سوالی.</p>"
        }
      ]
    },
    {
      "name": "announcement_bar_enabled",
      "value": "1"
    }
  ]
}

settings {
  encodeUrl: true
  timeout: 0
}
