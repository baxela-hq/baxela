meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/core/public/languages
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example EN, FA

  request: {
    url: {{baseUrl}}/api/v1/core/public/languages
    method: GET
    mode: none

    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": [
            {
              "code": "en",
              "name": "English",
              "native_name": "English",
              "is_rtl": false,
              "is_default": true
            },
            {
              "code": "fa",
              "name": "Persian",
              "native_name": "فارسی",
              "is_rtl": true,
              "is_default": false
            }
          ]
        }
      '''
    }
  }
}
