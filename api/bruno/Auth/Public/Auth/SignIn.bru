meta {
  name: SignIn
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/public/auth/signin
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "meysam4n@gmail.com",
    "password": "12345678"
  }
}

script:post-response {
  let data =res.body;
  console.log(data.data.token);
  bru.setEnvVar("token", data.data.token);
}
