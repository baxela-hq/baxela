meta {
  name: Unread Count
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/notification/user/notifications/unread-count
  body: none
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
