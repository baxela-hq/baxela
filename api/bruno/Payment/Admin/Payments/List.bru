meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/payment/admin/payments
  body: none
  auth: bearer
}

params:query {
  ~filter[status]: pending
  ~filter[method]: manual
  ~filter[order_id]: 1
  ~filter[transaction_id]: 777
  ~sort: -id
  ~per_page: 15
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Product 2",
    "slug": "product-3",
    "description": "this is a short description",
    "content": "<p>This is a long text!</p>",
    "base_price": "10.10",
    "type": "simple",
    "status": "published"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
