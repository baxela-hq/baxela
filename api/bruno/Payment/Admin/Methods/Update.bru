meta {
  name: Update
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/payment/admin/methods/:id
  body: json
  auth: bearer
}

params:path {
  id: 1
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "is_active": true,
    "sort_order": 10
  }
}

docs {
  Activates/deactivates a method and sets its checkout position (lower
  sort_order shows first). Both fields are required. Only active,
  configured methods with a registered driver are offered to customers;
  methods whose driver was removed cannot be updated.
}
