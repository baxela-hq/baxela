meta {
  name: Webhook
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/payment/public/webhook/manual
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "transaction_id": "1",
    "status": "success"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Gateway callback endpoint. Each real driver (stripe, paypal, ...) gets its
  own driver segment and verifies the payload signature itself. The `manual`
  driver rejects webhooks with payment.webhook.not_supported.
}
