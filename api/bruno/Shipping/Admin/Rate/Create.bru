meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/shipping/admin/rates
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "method_id": 1,
    "zone_id": 1,
    "price": "5.00"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
