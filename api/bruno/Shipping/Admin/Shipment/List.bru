meta {
  name: List
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/shipping/admin/shipments?per_page=100
  body: none
  auth: bearer
}

params:query {
  per_page: 100
  @description('id, shipped_at, delivered_at')
  ~sort: -id
  ~filter[status]:
  ~filter[order_id]:
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
