meta {
  name: List
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/shipping/admin/methods?per_page=100
  body: none
  auth: bearer
}

params:query {
  per_page: 100
  @description('id, code, position')
  ~sort: -position
  ~filter[code]:
  ~filter[is_active]:
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
