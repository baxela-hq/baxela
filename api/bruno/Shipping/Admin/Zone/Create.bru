meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/shipping/admin/zones
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Domestic US",
    "is_active": true,
    "position": 1,
    "country_codes": ["US"]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
