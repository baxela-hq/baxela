meta {
  name: Run
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/catalog/admin/data/import
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "media_id": 1,
    "on_duplicate": "update",
    "dry_run": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
