meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/catalog/admin/attribute-groups
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "position": 1,
    "translations": [
      {
        "language": "en",
        "title": "Display"
      },
      {
        "language": "fa",
        "title": "نمایشگر"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
