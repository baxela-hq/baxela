meta {
  name: List
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/catalog/admin/attribute-templates
  body: none
  auth: bearer
}

params:query {
  ~filter[title]: Mobile
  ~filter[is_active]: true
  ~sort: position
  ~per_page: 15
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
