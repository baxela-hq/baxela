meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/catalog/admin/attribute-templates
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Mobile v3",
    "description": "Form layout for phones",
    "is_active": true,
    "position": 1,
    "group_ids": [1, 2]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
