# Baxela shared-hosting (FTP/SFTP) deploy config. Copy to .env.sharedhosting
# at the repo root and fill in real values before the first
# `./infrastructure/sharedhosting/deploy.sh`.
#
# Deploys the BACKEND ONLY to a classic shared host (cPanel & co.). Admin and
# storefront keep their existing hosting. Full runbook:
# infrastructure/sharedhosting/README.md

# --- Transport ---------------------------------------------------------------
# rsync = host offers SSH (best: incremental sync + post-deploy over SSH)
# sftp  = lftp over SFTP (most cPanel hosts)
# ftp   = lftp over plain FTP (the password travels in cleartext — avoid)
SHAREDHOSTING_PROTOCOL=sftp
SHAREDHOSTING_HOST=ftp.example.com
# 22 for rsync/sftp, 21 for ftp
SHAREDHOSTING_PORT=22
SHAREDHOSTING_USER=

# rsync only: private key the host accepts (password auth not supported).
SHAREDHOSTING_SSH_KEY=~/.ssh/id_ed25519

# sftp/ftp only: account password. Passed to lftp via the environment,
# never on the command line.
SHAREDHOSTING_PASSWORD=

# --- Remote layout -----------------------------------------------------------
# App root on the host, relative to your home dir (no leading/trailing slash).
SHAREDHOSTING_REMOTE_DIR=baxela
# custom = the panel lets you point the (sub)domain docroot at
#          <REMOTE_DIR>/public (preferred — the app is served as designed)
# fixed  = the docroot is a fixed public_html: the script syncs public/ into
#          it with a patched index.php; app code stays outside the docroot
SHAREDHOSTING_DOCROOT_MODE=custom
# fixed mode only: name of the docroot directory inside your home dir.
SHAREDHOSTING_PUBLIC_DIR=public_html

# --- App ---------------------------------------------------------------------
# PHP binary on the host. "php" is usually right over SSH; on cPanel the
# version pinned for the site lives at e.g. /opt/cpanel/ea-php84/root/usr/bin/php
SHAREDHOSTING_PHP_BIN=php
# Public URL of the backend. Required for sftp/ftp (the post-deploy runner is
# called over HTTP) and rendered into the remote .env on --init.
SHAREDHOSTING_APP_URL=https://api.example.com

# Rendered into the remote .env on --init (create the database and user in
# the hosting panel first). Later deploys never overwrite the remote .env.
SHAREDHOSTING_DB_DATABASE=
SHAREDHOSTING_DB_USERNAME=
SHAREDHOSTING_DB_PASSWORD=
