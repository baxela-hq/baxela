includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    stubFiles:
        # Models Pest's bare test() helper as the running Tests\TestCase
        # (conditional return type) — the runtime proxy is opaque to
        # static analysis otherwise.
        - phpstan/test-stub.php
    universalObjectCratesClasses:
        # Fluent pending-call proxies — method calls resolve at runtime,
        # so static analysis cannot verify method names on them.
        - Pest\PendingCalls\TestCall
        - Pest\Support\HigherOrderTapProxy
    ignoreErrors:
        # Larastan's env() rule defaults to the root config/ dir only;
        # the modular-monolith config files under Modules/*/config are
        # equally "config" and must be exempted from
        # larastan.noEnvCallsOutsideOfConfig.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - Modules/*/config/*.php
    paths:
        - app
        - Modules
