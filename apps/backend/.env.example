APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated browser origins allowed to call the API (storefront, admin).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Password for the staff accounts created by the Auth database seeder. Leave
# unset to have a random one generated and printed once during seeding.
# ADMIN_USER_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Defaults match the develop compose stack (docker-compose.yml at the repo
# root): service names resolve on the compose network, creds come from
# DEV_DB_* in the root .env.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=baxela_backend
DB_USERNAME=baxela
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Realtime broadcasting (Laravel Reverb). The dev compose stack runs the
# reverb server on the published REVERB_DEV_PORT; REVERB_HOST/PORT/SCHEME
# are what clients (Echo) use to reach the websocket.
REVERB_APP_ID=1
REVERB_APP_KEY=baxela-local-key
REVERB_APP_SECRET=baxela-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Web push (OS-level browser notifications). Generate once with
# `php artisan notification:generate-vapid`; without keys the channel
# no-ops safely.
VAPID_SUBJECT="hello@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail defaults to the log for host-based development. When running the
# develop compose stack, start mailpit (docker compose --profile mail up -d)
# and switch to SMTP pointed at the mailpit service:
# MAIL_MAILER=smtp
# MAIL_HOST=mail
# MAIL_PORT=1025
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (hosted Checkout driver). Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET=
# Signing secret of the webhook endpoint pointing at POST /api/v1/payment/webhook/stripe
STRIPE_WEBHOOK_SECRET=
# Storefront return page receives the paid/cancelled customer back.
STRIPE_SUCCESS_URL="http://localhost:3000/en/payment/return?order_code={order_code}"
STRIPE_CANCEL_URL="http://localhost:3000/en/payment/return?order_code={order_code}&status=cancel"

# PayPal (Orders v2 hosted redirect driver). Sandbox credentials from
# https://developer.paypal.com/dashboard/applications
# sandbox|live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id of the endpoint pointing at POST /api/v1/payment/webhook/paypal
PAYPAL_WEBHOOK_ID=
# Storefront return page receives the approved/cancelled customer back.
PAYPAL_RETURN_URL="http://localhost:3000/en/payment/return?order_code={order_code}"
PAYPAL_CANCEL_URL="http://localhost:3000/en/payment/return?order_code={order_code}&status=cancel"

# Adyen (Pay by Link hosted redirect driver). Automatic-capture merchant
# accounts only. Credentials from https://ca-test.adyen.com (live: ca.adyen.com)
# test|live
ADYEN_ENV=test
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
# Standard-webhook HMAC key of the endpoint pointing at POST /api/v1/payment/webhook/adyen
ADYEN_HMAC_KEY=
# Storefront return page receives the customer back after the hosted page.
ADYEN_RETURN_URL="http://localhost:3000/en/payment/return?order_code={order_code}"

# NowPayments (crypto invoice driver). Credentials from https://nowpayments.io
# sandbox|live
NOWPAYMENTS_ENV=sandbox
NOWPAYMENTS_API_KEY=
# IPN secret from account settings; verifies x-nowpayments-sig on
# POST /api/v1/payment/webhook/nowpayments
NOWPAYMENTS_IPN_SECRET=
# Optional per-invoice IPN callback; when empty the account-level setting is used.
NOWPAYMENTS_IPN_CALLBACK_URL=
# Storefront return pages receive the paid/cancelled customer back.
NOWPAYMENTS_SUCCESS_URL="http://localhost:3000/en/payment/return?order_code={order_code}"
NOWPAYMENTS_CANCEL_URL="http://localhost:3000/en/payment/return?order_code={order_code}&status=cancel"
