# Copy to .env.local and adjust. The API base URL of the Laravel backend
# (develop compose nginx publishes :8085; a local nginx vhost may use
# baxela-backend.local).
NEXT_PUBLIC_API_BASE_URL=http://baxela-backend.local/api/v1

# Laravel Reverb websocket (realtime notifications) — same key as
# apps/backend/.env REVERB_APP_KEY; host/port are what the browser uses.
NEXT_PUBLIC_REVERB_APP_KEY=baxela-local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
