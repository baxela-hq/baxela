# Baxela GCP free-tier (demo) environment. Copy to .env.gcp at the repo root
# and fill in real values before the first
# `docker compose --env-file .env.gcp -f docker-compose.gcp.yml up`.
#
# Everything here is passed to the backend containers via env_file — Laravel
# reads its configuration directly from these variables. No secrets are baked
# into the images. This file is the backend-only, no-Redis variant of
# .env.production.example.

# --- Laravel runtime --------------------------------------------------------
APP_NAME=Baxela
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL through the Cloudflare proxy (see infrastructure/gcp/README.md).
APP_URL=https://demo-api.baxela.com

# stderr ships Laravel logs to the container's log stream (docker logs).
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=baxela
DB_USERNAME=baxela
DB_PASSWORD=change-me

# No Redis on the free-tier VM: everything goes through the database driver.
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@baxela.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- MySQL container init ---------------------------------------------------
# MYSQL_DATABASE/USER/PASSWORD are derived from DB_* above; only the root
# password is separate.
MYSQL_ROOT_PASSWORD=change-me-root

# --- Host ports ---------------------------------------------------------------
# 80 is required: Cloudflare's Flexible SSL proxies to plain HTTP on this port.
BACKEND_PORT=80
