# Template for the Laravel .env on the shared host (shared-hosting mode).
# deploy.sh renders the placeholders from .env.sharedhosting and uploads
# the result as <REMOTE_DIR>/.env on --init. Later deploys never overwrite
# the remote file — edit it in the hosting panel's file manager instead.

APP_NAME=Baxela
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL={{APP_URL}}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Single log file — no daily rotation machinery on shared hosting.
LOG_CHANNEL=single
LOG_LEVEL=info

# Shared hosts run MySQL on localhost; create the database and user in the
# hosting panel and pass the values via .env.sharedhosting (--init).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE={{DB_DATABASE}}
DB_USERNAME={{DB_USERNAME}}
DB_PASSWORD={{DB_PASSWORD}}

# Shared-hosting mode (apps/backend/docs/onboarding.md §5): no Redis and no
# workers — sessions in the database, cache in files, events run in-request.
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=file

FILESYSTEM_DISK=local

# Switch to the host's SMTP relay when the app should really send mail.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
