# Copy to .env for local development.
# This file only holds compose-level / infra variables (ports, user ids, etc.).
# Each app keeps its own environment inside apps/<app>/.env(.example).

# ---------------------------------------------------------------------------
# Build / runtime user (matches host user to avoid file permission issues)
# ---------------------------------------------------------------------------
WWWUSER=1000
WWWGROUP=1000

# ---------------------------------------------------------------------------
# Host port mappings (change only if ports conflict on your machine)
# ---------------------------------------------------------------------------
BACKEND_APP_PORT=8085        # nginx -> backend
BACKEND_MYSQL_PORT=3308
BACKEND_REDIS_PORT=6378

# ---------------------------------------------------------------------------
# Database (used only by dev compose)
# ---------------------------------------------------------------------------
LEGACY_DB_DATABASE=xshop
LEGACY_DB_USERNAME=xshop
LEGACY_DB_PASSWORD=password
DB_PASSWORD=password
