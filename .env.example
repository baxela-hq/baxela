# Copy to .env at the repo root for the development compose environment.
# This file holds only infra-level variables (ports, container credentials,
# frontend dev-server wiring). Each app keeps its own environment in
# apps/<app>/.env(.example) when run outside compose.

# ---------------------------------------------------------------------------
# Build / runtime user (matches host user to avoid file permission issues)
# ---------------------------------------------------------------------------
WWWUSER=1000
WWWGROUP=1000

# ---------------------------------------------------------------------------
# Host port mappings (change only if ports conflict on your machine)
# ---------------------------------------------------------------------------
BACKEND_APP_PORT=8085        # nginx -> backend
BACKEND_MYSQL_PORT=3308
BACKEND_REDIS_PORT=6378
MAILPIT_PORT=8025            # only used with the `mail` profile

# ---------------------------------------------------------------------------
# Frontend dev servers (`frontend` compose profile)
# ---------------------------------------------------------------------------
# Start the admin/storefront dev containers with the rest of the stack.
# Set to empty (or delete the line) for a backend-only stack.
COMPOSE_PROFILES=frontend

ADMIN_DEV_PORT=5173          # Vite dev server (admin)
STOREFRONT_DEV_PORT=3000     # Next.js dev server (storefront)

# Browser-facing API URLs: the browser runs on the host, so these must be
# host-reachable (keep the port in sync with BACKEND_APP_PORT).
VITE_API_BASE_URL=http://localhost:8085/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8085/api/v1
# VITE_CLERK_PUBLISHABLE_KEY is optional — only for the /clerk/* demo tree.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_STORE_FRONT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# MySQL container credentials (dev only — keep in sync with apps/backend/.env)
# ---------------------------------------------------------------------------
DEV_DB_DATABASE=xshop_backend
DEV_DB_USERNAME=xshop
DEV_DB_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
