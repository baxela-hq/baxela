# Baxela production environment. Copy to .env.production at the repo root and
# fill in real values before the first
# `docker compose --env-file .env.production -f docker-compose.prod.yml up`.
#
# Everything except the host ports and frontend build args is passed to the
# backend containers via env_file — Laravel reads its configuration directly
# from these variables. No secrets are baked into the images.

# --- Laravel runtime --------------------------------------------------------
APP_NAME=Baxela
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# stderr ships Laravel logs to the container's log stream (docker logs).
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=baxela
DB_USERNAME=baxela
DB_PASSWORD=change-me

SESSION_DRIVER=database
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Realtime broadcasting (Laravel Reverb). The reverb container serves the
# websocket behind nginx's /app/ location, so clients use the public API
# host over TLS.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=1
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=api.example.com
REVERB_PORT=443
REVERB_SCHEME=https

# Web push (OS-level browser notifications). Generate once with
# `php artisan notification:generate-vapid` (on any machine).
VAPID_SUBJECT="hello@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- MySQL container init ---------------------------------------------------
# MYSQL_DATABASE/USER/PASSWORD are derived from DB_* above; only the root
# password is separate.
MYSQL_ROOT_PASSWORD=change-me-root

# --- Host ports ---------------------------------------------------------------
BACKEND_PORT=8080
ADMIN_PORT=8081
STOREFRONT_PORT=8082

# --- Admin build args (baked into the SPA bundle at build time) ---------------
VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_STORE_FRONT_URL=https://example.com
VITE_REVERB_APP_KEY=change-me-reverb-key
VITE_REVERB_HOST=api.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Web push (OS-level browser notifications). Generate once with
# `php artisan notification:generate-vapid` (on any machine).
VAPID_SUBJECT="hello@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Storefront build arg / runtime -------------------------------------------
# NEXT_PUBLIC_* is baked into the client bundle at build time (like VITE_*);
# SERVER_API_BASE_URL is runtime-only and defaults to the compose network's
# nginx service.
NEXT_PUBLIC_REVERB_APP_KEY=change-me-reverb-key
NEXT_PUBLIC_REVERB_HOST=api.example.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# Web push (OS-level browser notifications). Generate once with
# `php artisan notification:generate-vapid` (on any machine).
VAPID_SUBJECT="hello@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
SERVER_API_BASE_URL=http://backend-nginx/api/v1
