# Root-level ignore for builds whose context is the repo root (docker
# compose -f docker-compose.prod.yml build). The per-Dockerfile
# Dockerfile.dockerignore files already whitelist exactly what each image
# needs under BuildKit; this file is the safety net for classic-builder
# builds, which only read this root ignore. Its job is to keep secrets and
# local state out of image layers.

# --- Secrets & local state (never bake into an image) -----------------------
.env
.env.*
!.env.example
!.env.production.example
!.env.sharedhosting.example
apps/*/.env
apps/*/.env.*
!apps/*/.env.example
api/bruno/environments/*

# --- Dependencies & build output (rebuilt inside the images) ----------------
**/node_modules
**/vendor
apps/admin/dist
apps/storefront/.next
apps/backend/bootstrap/cache/*

# --- VCS, CI and tooling -----------------------------------------------------
.git
.github
.githooks
.zcode
.zcodeignore
docs
api
scripts
infrastructure/sharedhosting
